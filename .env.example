# Telegram API credentials — get from https://my.telegram.org
API_ID=
API_HASH=

# MTKruto auth string for the userbot account
# Generate with: bun run gen-session
SESSION=

# Bot token from @BotFather
BOT_TOKEN=

# Numeric chat ID where the bot sends operational logs
LOG_CHANNEL=

# Optional: default thumbnail URL for tracks without artwork
# THUMBNAIL=https://telegra.ph/file/6b07279fd80ef2b844ed0.png

# Optional: watermark text on Now Playing banners
# WATERMARK=TGVCBot

# Optional: log verbosity — silent | error | warn | info | debug | verbose (default: info)
# LOG_LEVEL=info

# Optional: native ntgcalls (C++) log level — silent | error | warn | info | debug (default: error)
# Raise to debug only when diagnosing the native streaming layer; it is very verbose.
# NTGCALLS_LOG_LEVEL=error

# Optional: Mini App short name registered with @BotFather. When set, /play and /app
# show a button that opens https://t.me/<bot>/<short-name> as a Mini App inside
# Telegram (works in groups, no domain whitelist needed). Leave unset to disable.
# WEBAPP_SHORT_NAME=control